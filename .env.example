# Qanony — environment variables. Copy to .env.local for development.
# Never commit real values. Variables prefixed NEXT_PUBLIC_ are exposed to the browser;
# everything else is server-only. See ENVIRONMENT_VARIABLES.md for details.

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (required) ----------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used after authorisation checks for signed storage URLs, webhooks and workers.
SUPABASE_SERVICE_ROLE_KEY=

# --- Payments ---------------------------------------------------------------
# paymob | sandbox. Defaults to sandbox when PAYMENTS_SANDBOX_ENABLED=true, else paymob.
PAYMENTS_PROVIDER=
# Paymob (Egypt) — Unified Intention API. NOT verified against a live account in this repo.
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
# Comma-separated integration IDs (card, wallet, ...)
PAYMOB_INTEGRATION_IDS=
PAYMOB_MODE=test
PAYMOB_API_BASE=https://accept.paymob.com
# Simulated gateway for development/QA. Never enable in production.
PAYMENTS_SANDBOX_ENABLED=false
PAYMENTS_SANDBOX_SECRET=

# --- Video consultations (Daily.co) ----------------------------------------
DAILY_API_KEY=

# --- AI assistant (Anthropic) ----------------------------------------------
ANTHROPIC_API_KEY=
# Optional override; default claude-opus-5-5
AI_MODEL=

# --- Malware scanning (optional; ClamAV REST wrapper) ----------------------
CLAMAV_SCAN_URL=
CLAMAV_SCAN_TOKEN=

# --- Notifications ----------------------------------------------------------
# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM="Qanony <no-reply@example.com>"
# SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# WhatsApp (Meta Cloud API) — requires an approved template taking {{1}} title and {{2}} body
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_API_VERSION=v21.0

# --- Scheduled jobs ---------------------------------------------------------
# At least 16 random characters; sent as "Authorization: Bearer <secret>" by the scheduler.
CRON_SECRET=

# --- E2E tests (optional) ---------------------------------------------------
# E2E_BASE_URL=
# E2E_BROWSER_CHANNEL=chrome
# E2E_SUPABASE=1
# E2E_CLIENT_EMAIL= / E2E_CLIENT_PASSWORD=
# E2E_LAWYER_EMAIL= / E2E_LAWYER_PASSWORD= / E2E_LAWYER_SLUG=
# E2E_ADMIN_EMAIL= / E2E_ADMIN_PASSWORD=
